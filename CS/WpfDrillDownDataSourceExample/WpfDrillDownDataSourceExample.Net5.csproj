<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WpfDrillDownDataSourceExample</RootNamespace>
    <AssemblyName>WpfDrillDownDataSourceExample</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x86;AnyCPU</Platforms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>obj*/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Data.Desktop" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.DataAccess" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Mvvm" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.PivotGrid.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Printing.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Core.Extensions" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Grid.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.PivotGrid" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Printing" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.Office2016White" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.Office2019Colorful" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.All" Version="26.1.*-*" />
  </ItemGroup>
</Project>
